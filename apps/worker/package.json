{
  "name": "@regmar/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply marriage-registry --local",
    "db:migrate:remote": "wrangler d1 migrations apply marriage-registry --remote",
    "db:seed:local": "wrangler d1 execute marriage-registry --local --file=scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute marriage-registry --remote --file=scripts/seed.sql",
    "generate:hash": "node scripts/generateHash.mjs",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@regmar/shared": "workspace:*",
    "@hono/zod-validator": "^0.4.3",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.20",
    "jose": "^5.9.6",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/bcryptjs": "^2.4.6",
    "drizzle-kit": "^0.30.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "wrangler": "^3.101.0"
  }
}
