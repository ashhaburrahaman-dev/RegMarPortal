# ─────────────────────────────────────────────
# Worker secrets (set via: wrangler secret put)
# ─────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-256-bit-string-at-least-32-chars

# ─────────────────────────────────────────────
# Worker vars (set in wrangler.toml [vars])
# ─────────────────────────────────────────────
ALLOWED_ORIGIN=https://your-pages-domain.pages.dev

# ─────────────────────────────────────────────
# Client env (Cloudflare Pages dashboard → Settings → Env vars)
# Local override: apps/client/.env.local
# ─────────────────────────────────────────────
VITE_API_BASE_URL=https://your-worker.workers.dev/api/v1

# ─────────────────────────────────────────────
# GitHub Secrets (repo Settings → Secrets → Actions)
# ─────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
